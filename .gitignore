# ==============================================================================
# QuickAttend - .gitignore Configuration
# Comprehensive gitignore for React Native, Expo, Node.js, Android, iOS, & IDEs
# ==============================================================================

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Node & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml

# Environment variables & Local configuration
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example

# Build artifacts & caches
dist/
build/
out/
.next/
.turbo/
.cache/
coverage/
*.lcov
.nyc_output/

# Expo & React Native
.expo/
.expo-shared/
web-build/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Android
android/.gradle/
android/app/build/
android/build/
android/local.properties
android/captures/
*.apk
*.aab
*.ap_

# iOS (Xcode)
ios/Pods/
ios/build/
ios/DerivedData/
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
*.xcuserstate
project.xcworkspace/xcuserdata/
xcuserdata/

# IDEs & Text Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.iml
*.iws
*.ipr
*.sublime-project
*.sublime-workspace
.fleet/

# Temporary, scratch & logs
*.log
*.tmp
*.temp
tmp/
temp/
scratch/
scripts/*.log

