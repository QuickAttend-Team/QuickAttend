# ==============================================================================
# QuickAttend - .gitignore Configuration
# Comprehensive gitignore for pnpm Monorepo, React Native (Expo), Express, Prisma & PostgreSQL
# ==============================================================================

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Node & pnpm Package Manager
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# TypeScript & Prisma generated artifacts
*.tsbuildinfo
src/generated/
apps/*/src/generated/

# Environment variables & Local configuration
.env
.env.*
!.env.example
*.pem
*.key

# Build artifacts & caches
dist/
build/
out/
.next/
.turbo/
.cache/
coverage/
*.lcov
.nyc_output/

# Expo & React Native
.expo/
.expo-shared/
web-build/
*.jks
*.p8
*.p12
*.mobileprovision
*.orig.*

# Android
android/.gradle/
android/app/build/
android/build/
android/local.properties
android/captures/
*.apk
*.aab
*.ap_

# iOS (Xcode)
ios/Pods/
ios/build/
ios/DerivedData/
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
*.xcuserstate
project.xcworkspace/xcuserdata/
xcuserdata/

# IDEs & Text Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.iml
*.iws
*.ipr
*.sublime-project
*.sublime-workspace
.fleet/
*.swp
*.swo

# Temporary, scratch, reference & local scripts
*.log
*.tmp
*.temp
tmp/
temp/
scratch/
scripts/
15-SPM-35/
