# ==============================================================================
# QuickAttend Environment Configuration (.env.example)
# Copy this file to .env (and apps/api/.env if running Prisma CLI inside apps/api)
# ==============================================================================

# PostgreSQL 18 Connection String
DATABASE_URL="postgresql://quickattend:QuickAttendLocal2026@localhost:5432/quickattend?schema=public"

# Security Secrets (Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=""
OTP_HMAC_SECRET=""

# Backend API Server
API_PORT=4000
NODE_ENV="development"

# Mobile Client (Expo Public Env)
EXPO_PUBLIC_API_URL="http://localhost:4000/api"

