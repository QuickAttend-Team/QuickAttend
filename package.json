{
  "name": "quickattend",
  "version": "0.1.0",
  "private": true,
  "description": "QuickAttend - One-Tap Mobile Attendance & Session Delegation System (CO3043 - HCMUT)",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev:api": "pnpm --filter @quickattend/api dev",
    "dev:mobile": "pnpm --filter @quickattend/mobile start",
    "build": "pnpm --filter @quickattend/contracts build && pnpm --filter @quickattend/api build",
    "start:api": "pnpm --filter @quickattend/api start",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm --filter @quickattend/api test",
    "db:generate": "pnpm --filter @quickattend/api db:generate",
    "db:migrate": "pnpm --filter @quickattend/api db:migrate",
    "db:seed": "pnpm --filter @quickattend/api db:seed",
    "db:reset": "pnpm --filter @quickattend/api db:reset"
  }
}

